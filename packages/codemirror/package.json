{
  "name": "@herald/codemirror",
  "version": "0.1.0",
  "description": "CodeMirror 6 editor adapter for Herald.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjbroodryk/herald.git",
    "directory": "packages/codemirror"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --format esm --target browser --packages external && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@herald/core": "workspace:*",
    "@herald/markdown": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6"
  }
}
