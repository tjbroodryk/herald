{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    // inside the repo @herald/* resolves to source, so tests, checks and the example need no build
    "paths": {
      "@herald/react": ["./packages/react/src/index.tsx"],
      "@herald/ui": ["./packages/ui/src/index.tsx"],
      "@herald/ui/styles.css": ["./packages/ui/src/styles.css"],
      "@herald/*": ["./packages/*/src/index.ts"],
      // the shadcn registry source imports the way installed shadcn files do
      "@/lib/utils": ["./packages/shadcn/lib/utils.ts"],
      "@/registry/herald/*": ["./packages/shadcn/registry/herald/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["node_modules", "**/dist", "site"]
}
